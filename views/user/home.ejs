<%- include("../../views/partials/user/header") %>

<style>
  .products .card {
    width: 8cm;
    height: 8cm;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 2px solid white; /* Classic beige border */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Subtle shadow for depth */
    transition: transform 0.3s ease, box-shadow 0.3s ease; /* Smooth hover effect */
    margin: 0; /* Remove margin */
  }
  .products .card:hover {
    transform: translateY(-5px); /* Lift effect on hover */
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2); /* Enhanced shadow on hover */
  }
  .products .card-img-top {
    height: 6cm;
    object-fit: cover;
    border-bottom: 1px solid #d3c1a5; /* Subtle separator */
  }
  .products .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.5rem;
    background-color: white; /* Warm cream background for classic feel */
    font-family: 'Georgia', serif; /* Classic serif font */
  }
  .products .card-title {
    font-size: 1.1rem;
    color: #4a3c2f; /* Dark brown for elegance */
    margin-bottom: 0.25rem;
    font-weight: bold;
  }
  .products .card-text {
    font-size: 0.9rem;
    color: #6b4e31; /* Medium brown for contrast */
    margin-bottom: 0.5rem;
  }
  .products .btn-primary {
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
    background-color:black; /* Rich brown button */
    border-color:black;
    font-family: 'Georgia', serif;
  }
  .products .btn-primary:hover {
    background-color:black; /* Darker shade on hover */
    border-color: black;
  }
  .products .row {
    display: flex;
    flex-wrap: nowrap; /* Prevent wrapping to new row */
    margin: 0; /* Remove row margin */
    gap: 0; /* Remove gap between columns */
  }
  .products .col-12 {
    padding: 0; /* Remove column padding */
  }
  .products .card-container {
    display: flex;
    justify-content: space-between; /* Evenly space five cards */
    width: 100%;
  }
</style>

<section class="products py-5">
  <div class="container">
    <div class="section-header text-center mt-5">
      <h3 class="section-title">New collections</h3>
    </div>
    <div class="row">
      <div class="col-12">
        <div class="card-container">
          <% if (products && products.length > 0) { %>
            <% products.slice(0, 5).forEach(product => { %>
              <div class="card h-100 shadow-sm">
                <img src="/Uploads/re-image/<%= product.productImage[0] %>" class="card-img-top" alt="<%= product.productName %>">
                <div class="card-body text-center">
                  <h5 class="card-title"><%= product.productName %></h5>
                  <p class="card-text text-muted"><%= product.brand %></p>
                  <p class="card-text">
                    <% if (product.finalamount > 0) { %>
                      <span class="text-success fw-bold">$<%= product.finalamount %></span>
                      <span class="text-decoration-line-through text-muted">₹<%= product.regularPrice %></span>
                    <% } else { %>
                      <span class="text-success fw-bold">₹<%= product.salePrice %></span>
                      <% if (product.regularPrice > product.salePrice) { %>
                        <span class="text-decoration-line-through text-muted">₹<%= product.regularPrice %></span>
                      <% } %>
                    <% } %>
                  </p>
                  <a href="/productDetails?id=<%= product._id %>" class="btn btn-primary">View Details</a>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center">
              <p>No products available at the moment.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

